{% extends "generic_show_form.html.twig" %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% set params = params ?? [] %}

{% block form_fields %}
    {% block more_fields %}
        {{ fields.dropdownArrayField('enable_custom_css', item.fields['enable_custom_css'], enable_css_options, __('Enable CSS customization'), {
            add_field_html: enable_css_inheritance_label
        }) }}
        {% set inherited_value = enabled_css_inherited_value %}
        {% set show_editor = item.fields['enable_custom_css'] == 1 or (item.fields['enable_custom_css'] == constant('Entity::CONFIG_PARENT') and inherited_value == 1) %}
        <div id="custom_css_container" class="custom_css_container {{ show_editor ? '' : 'd-none' }}" style="height: 400px"></div>
        <div data-custom-css-disabled class="alert alert-info {{ show_editor ? 'd-none' : '' }}">{{ __('Custom CSS is disabled') }}</div>
        <script>
            $(() => {
                import('/js/modules/Entity/CustomCssEditor.js').then(({initCustomCssEditor}) => {
                    initCustomCssEditor(document.getElementById('custom_css_container'), {
                        customCss: '{{ item.fields['custom_css_code']|escape('js') }}',
                        inheritedCss: '{{ inherited_css|default('')|escape('js') }}',
                        inheritedEnabled: {{ inherited_value == 1 ? 'true' : 'false' }},
                        canEdit: {{ params.canedit ? 'true' : 'false' }},
                    });
                });
            });
        </script>
    {% endblock %}
{% endblock %}
